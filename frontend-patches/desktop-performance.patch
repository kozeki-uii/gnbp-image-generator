+        return new File([blob], `desktop-image-${Date.now()}-${index + 1}.${subtype}`, {
+          type: blob.type || 'image/png',
+        })
+      })).then((files) => handleFilesRef.current(files)).catch((error) => {
+        useStore.getState().showToast(
+          `图片添加失败：${error instanceof Error ? error.message : String(error)}`,
+          'error',
+        )
+      })
+    }
+
+    const handleDesktopDragState = (event: Event) => {
+      const active = (event as CustomEvent<unknown>).detail === true
+      dragCounter.current = active ? 1 : 0
+      setIsDragging(active)
+    }
+
+    window.addEventListener(DESKTOP_IMAGES_EVENT, handleDesktopImages)
+    window.addEventListener(DESKTOP_DRAG_STATE_EVENT, handleDesktopDragState)
+    return () => {
+      window.removeEventListener(DESKTOP_IMAGES_EVENT, handleDesktopImages)
+      window.removeEventListener(DESKTOP_DRAG_STATE_EVENT, handleDesktopDragState)
+    }
+  }, [])
