+/* 桌面壳保留弹窗质感，但避免全屏实时模糊触发整页重合成。 */
+html[data-gnbp-desktop='true'] .fixed.inset-0 > .absolute.inset-0[class*='backdrop-blur'] {
+  -webkit-backdrop-filter: none !important;
+  backdrop-filter: none !important;
+}
+
+@keyframes desktop-overlay-in {
+  from { opacity: 0; }
+  to { opacity: 1; }
+}
+
+@keyframes desktop-modal-in {
+  from { opacity: 0; transform: translateY(6px); }
+  to { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes desktop-zoom-in {
+  from { opacity: 0; transform: scale(0.985); }
+  to { opacity: 1; transform: scale(1); }
+}
+
+html[data-gnbp-desktop='true'] .animate-overlay-in,
+html[data-gnbp-desktop='true'] .animate-fade-in {
+  animation: desktop-overlay-in 0.12s ease-out both;
+}
+
+html[data-gnbp-desktop='true'] .animate-modal-in,
+html[data-gnbp-desktop='true'] .animate-slide-down-in,
+html[data-gnbp-desktop='true'] .animate-confirm-in {
+  animation: desktop-modal-in 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
+html[data-gnbp-desktop='true'] .animate-zoom-in {
+  animation: desktop-zoom-in 0.16s cubic-bezier(0.16, 1, 0.3, 1) both;
+}
+
